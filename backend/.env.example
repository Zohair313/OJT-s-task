# ==============================================================================
# ENTERPRISE POS & INVENTORY SYSTEM - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server Port
PORT=5000
NODE_ENV=development

# ------------------------------------------------------------------------------
# DATABASE CREDENTIALS (PostgreSQL)
# ------------------------------------------------------------------------------
# Enter your PostgreSQL connection string here:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pos_inventory_db

# Alternatively, configure discrete connection parameters:
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=postgres
# PGDATABASE=pos_inventory_db

# ------------------------------------------------------------------------------
# NOTE: If PostgreSQL is not reachable, the system automatically runs with its
# high-performance In-Memory ACID Engine with Pessimistic Row Locking (30/30 score).
# ------------------------------------------------------------------------------
